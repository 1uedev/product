# decision-evidence: configuration template. Copy to .env (demo: optional) or .env.prod (production) and fill in.
# Never commit real values. Docker Compose reads .env automatically; production: --env-file .env.prod

# ---------------------------------------------------------------- demo stack (compose.yaml)
# Everything below is OPTIONAL for the demo: known demo defaults are built into compose.yaml.
# COMPOSE_PROJECT_NAME=decision-evidence   # change it to run several tools side by side
# APP_PORT=8480                            # published on 127.0.0.1 only
# AI_PROVIDER=mock                         # mock = explicit, deterministic demo adapter (no external calls)
# For a real model:
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=                       # server-side only, never in the browser
# ANTHROPIC_MODEL=claude-sonnet-5-5        # check the capabilities of your model (structured outputs) before choosing
# Local model through Ollama instead (nothing leaves your network, see docs/operations/ollama.md):
# AI_PROVIDER=ollama
# OLLAMA_MODEL=qwen3:8b                    # must be installed on the Ollama server (ollama pull ...)
# OLLAMA_BASE_URL=http://host.docker.internal:11434   # Ollama on the Docker host; the overlay compose.ollama.yaml sets http://ollama:11434
# OLLAMA_NUM_CTX=8192                      # context window in tokens; prompts that do not fit are refused, never truncated silently
# EXTRA_CA_BUNDLE=/path/to/ca.pem          # only for image builds behind a TLS-inspecting proxy

# ---------------------------------------------------------------- production (compose.prod.yaml): ALL REQUIRED
# COMPOSE_PROJECT_NAME=decision-evidence-prod
# DE_VERSION=1.0.0                         # image tag of this release
# PUBLIC_HOST=decisions.example.org        # DNS name of the server (automatic HTTPS needs ports 80/443)
# PUBLIC_ORIGIN=https://decisions.example.org
# AI_PROVIDER=anthropic                    # or ollama (OLLAMA_MODEL, no API key needed); the demo adapter is refused in production
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# Secrets: at least 16 random characters each, no demo/default words. Generate e.g. with: openssl rand -base64 24 | tr '+/' '-_' | tr -d '='
# POSTGRES_PASSWORD=
# DB_MIGRATOR_PASSWORD=
# DB_AUTH_PASSWORD=
# DB_APP_PASSWORD=
# DB_WORKER_PASSWORD=
# DB_OUTBOX_PASSWORD=
# KEYCLOAK_DB_PASSWORD=
# KEYCLOAK_ADMIN_PASSWORD=
# OIDC_CLIENT_SECRET=
# RABBITMQ_PASSWORD=
# S3_ACCESS_KEY=                           # letters, digits, '-' and '_' only
# S3_SECRET_KEY=
# SECRET_KEY=                              # Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# First tenant (optional, run once; prints a one-time owner invitation link in the bootstrap log):
# BOOTSTRAP_TENANT_SLUG=acme
# BOOTSTRAP_TENANT_NAME=Acme GmbH
# BOOTSTRAP_OWNER_EMAIL=owner@example.org
